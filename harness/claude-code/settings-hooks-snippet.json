{
  "_comment": "Paste the 'hooks' block into your Claude Code settings.json (project or user level).",
  "_comment_hooks_path": "Project: <project>/.claude/settings.json  |  User: ~/.claude/settings.json",
  "_comment_placeholder": "Replace <PIERIA_HARNESS_DIR> with the absolute path to the harness/ directory.",

  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh <PIERIA_HARNESS_DIR>/claude-code/session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh <PIERIA_HARNESS_DIR>/claude-code/pre-compact.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh <PIERIA_HARNESS_DIR>/claude-code/stop.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh <PIERIA_HARNESS_DIR>/claude-code/session-end.sh"
          }
        ]
      }
    ]
  }
}
