  },
  {
    "key": "pieria.ingestion.trace.spool-max-bytes",
    "scope": "global",
    "section": "traces",
    "tier": "restart",
    "kind": "int",
    "label": "Spool size cap (bytes)",
    "hint": "The oldest half of a session's spool is dropped past this, so a runaway session cannot fill the disk."
  },
  {
    "key": "pieria.ingestion.trace.spool-retention-days",
    "scope": "global",
    "section": "traces",
    "tier": "restart",
    "kind": "int",
    "label": "Spool retention (days)",
    "hint": "Age at which an abandoned spool file is swept by the next turn-end hook."
  },
  {
    "key": "pieria.ingestion.trace.stop-drain-threshold-bytes",
    "scope": "global",
    "section": "traces",
    "tier": "restart",
    "kind": "int",
    "label": "End-of-turn drain size (bytes)",
    "hint": "Spool size at which the Stop hook ships early. Lower drains sooner but cuts batches down toward one turn."
  },
  {
    "key": "pieria.ingestion.trace.stop-drain-threshold-events",
    "scope": "global",
    "section": "traces",
    "tier": "restart",
    "kind": "int",
    "label": "End-of-turn drain count",
    "hint": "Event count at which the Stop hook ships early. A failure and its fix usually span turns, and only a batch covering both yields a recipe."
  },
  {
    "key": "pieria.ingestion.trace.tool-denylist",
    "scope": "global",
    "section": "traces",
    "tier": "restart",
    "kind": "string",
    "label": "Tools worth no memory",
    "hint": "Comma-separated. Successful calls to these are dropped as noise; a failure is still captured."
  },
  {
    "key": "pieria.ingestion.trace.skip-unchanged-outcomes",
    "scope": "global",
    "section": "traces",
    "tier": "restart",
    "kind": "bool",
    "label": "Skip unchanged outcomes",
    "hint": "Drops a trace whose active outcome already records the same status and error digest, which is the dominant source of repeat rows."
  },
  {
    "key": "pieria.ingestion.trace.recipe-extraction-enabled",
    "scope": "global",
    "section": "traces",
    "tier": "restart",
    "kind": "bool",
    "label": "Derive procedural recipes",
    "hint": "The one model call on the trace path. Off keeps the deterministic outcome events and stops generalizing reusable instructions."
  },
  {
    "key": "pieria.ingestion.trace.max-recipes-per-batch",
