{
  "resources": {
    "includes": [
      {
        "pattern": "application.*"
      },
      {
        "pattern": "config/pieria-default\\.properties"
      },
      {
        "pattern": "config/pieria-default-config\\.toml"
      },
      {
        "pattern": "config/config-schema\\.json"
      },
      {
        "pattern": "db/migration/.*\\.sql"
      },
      {
        "pattern": "native/.*/vec0\\..*"
      },
      {
        "pattern": "native/.*/libtree-sitter\\..*"
      },
      {
        "pattern": "native/.*/tree-sitter-.*\\..*"
      },
      {
        "pattern": "code/langpack/.*\\.scm"
      },
      {
        "pattern": "prompts/.*\\.txt"
      },
      {
        "pattern": "org/apache/pdfbox/resources/.*"
      },
      {
        "pattern": "org/apache/fontbox/.*\\.txt"
      }
    ]
  }
}
